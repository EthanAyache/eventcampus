{% extends 'layout/main.html.twig' %}

{% block title %}Événements - EventCampus{% endblock %}

{% block content %}
    {% set evenements = evenements|default([]) %}

    <div class="container py-4">
        <div class="mb-4">
            <h1 class="h2 mb-1">Tous les événements</h1>
            <p class="text-body-secondary mb-0">{{ evenements|length }} événement{{ evenements|length > 1 ? 's' }} sur le campus</p>
        </div>

        {% include 'components/_filtres_categories.html.twig' %}

        {% if evenements is empty %}
            <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>Aucun événement pour le moment.</div>
        {% else %}
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
                {% for e in evenements %}
                    <div class="col">
                        {% include 'components/evenement_card.html.twig' with { evenement: e } %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
