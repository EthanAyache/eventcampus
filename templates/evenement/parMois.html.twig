{% extends 'layout/main.html.twig' %}

{% block title %}Événements de {{ mois }}/{{ annee }} - EventCampus{% endblock %}

{% block content %}
    {% set evenements = evenements|default([]) %}

    <div class="container py-4">
        <div class="mb-4">
            <h1 class="h2 mb-1">Événements de {{ mois }}/{{ annee }}</h1>
            <p class="text-body-secondary mb-0">{{ evenements|length }} événement{{ evenements|length > 1 ? 's' }} ce mois-ci</p>
        </div>

        {% if evenements is empty %}
            <div class="text-center py-5">
                <p class="lead mt-3">Aucun événement ce mois-ci.</p>
                <a href="{{ path('app_evenement') }}" class="btn btn-primary">Voir tous les événements</a>
            </div>
        {% else %}
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
                {% for e in evenements %}
                    <div class="col">
                        {% include 'components/evenement_card.html.twig' with { evenement: e } %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
