{# Filtres visuels par catégorie. Variable optionnelle : categorie (catégorie active) #}
{% set filtres = {
    culturel:   { label: 'Culturel',   icon: 'palette' },
    sportif:    { label: 'Sportif',    icon: 'trophy' },
    associatif: { label: 'Associatif', icon: 'people' },
    festif:     { label: 'Festif',     icon: 'stars' },
} %}
{% set active = categorie ?? null %}

<div class="d-flex flex-wrap gap-2 mb-4">
    <a href="{{ path('app_evenement') }}" class="btn btn-sm rounded-pill {{ active is null ? 'btn-primary' : 'btn-outline-primary' }}">
        <i class="bi bi-grid me-1"></i>Tous
    </a>
    {% for slug, f in filtres %}
        <a href="{{ path('app_evenement_categories', { categorie: slug }) }}"
           class="btn btn-sm rounded-pill btn-cat-{{ slug }} {{ active == slug ? 'active' }}">
            <i class="bi bi-{{ f.icon }} me-1"></i>{{ f.label }}
        </a>
    {% endfor %}
</div>
