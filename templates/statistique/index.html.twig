{% extends 'layout/main.html.twig' %}

{% block title %}Statistiques - EventCampus{% endblock %}

{% block content %}
    {% set evenements = evenements|default([]) %}
    {% set total = evenements|length %}
    {% set places_totales = evenements|reduce((c, e) => c + e.places_totales, 0) %}
    {% set places_restantes = evenements|reduce((c, e) => c + e.places_disponibles, 0) %}
    {% set places_occupees = places_totales - places_restantes %}
    {% set taux_global = places_totales > 0 ? (places_occupees / places_totales * 100)|round : 0 %}

    {% set categories = {
        culturel:   { label: 'Culturel',   icon: 'palette' },
        sportif:    { label: 'Sportif',    icon: 'trophy' },
        associatif: { label: 'Associatif', icon: 'people' },
        festif:     { label: 'Festif',     icon: 'stars' },
    } %}
    {% set statuts = {
        ouvert:  { label: 'Ouvert',  color: 'success' },
        complet: { label: 'Complet', color: 'danger' },
        annule:  { label: 'Annulé',  color: 'secondary' },
        termine: { label: 'Terminé', color: 'dark' },
    } %}

    <div class="container py-4">
        <h1 class="h2 mb-1">Statistiques</h1>
        <p class="text-body-secondary mb-4">Vue d'ensemble des événements du campus</p>

        {# Chiffres clés #}
        <div class="row g-3 mb-4">
            {% set chiffres = [
                { label: 'Événements', valeur: total, icon: 'calendar-event', color: 'primary' },
                { label: 'Places totales', valeur: places_totales, icon: 'grid-3x3', color: 'info' },
                { label: 'Places occupées', valeur: places_occupees, icon: 'person-check', color: 'success' },
                { label: 'Taux de remplissage', valeur: taux_global ~ ' %', icon: 'speedometer2', color: 'warning' },
            ] %}
            {% for c in chiffres %}
                <div class="col-6 col-lg-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="stat-icon bg-{{ c.color }}-subtle text-{{ c.color }}-emphasis">
                                <i class="bi bi-{{ c.icon }}"></i>
                            </div>
                            <div>
                                <div class="fs-3 fw-bold lh-1">{{ c.valeur }}</div>
                                <div class="small text-body-secondary">{{ c.label }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="row g-4">
            {# Répartition par catégorie #}
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 pt-4 px-4">
                        <h2 class="h5 mb-0"><i class="bi bi-pie-chart me-2"></i>Répartition par catégorie</h2>
                    </div>
                    <div class="card-body px-4">
                        {% for slug, cat in categories %}
                            {% set liste = evenements|filter(e => e.categorie == slug) %}
                            {% set nb = liste|length %}
                            {% set pct = total > 0 ? (nb / total * 100)|round : 0 %}
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <a href="{{ path('app_evenement_categories', { categorie: slug }) }}" class="link-body-emphasis link-underline-opacity-0 fw-semibold">
                                        <i class="bi bi-{{ cat.icon }} text-cat-{{ slug }} me-2"></i>{{ cat.label }}
                                    </a>
                                    <span class="small text-body-secondary">{{ nb }} événement{{ nb > 1 ? 's' }} · {{ pct }} %</span>
                                </div>
                                <div class="progress" role="progressbar" aria-valuenow="{{ pct }}" aria-valuemin="0" aria-valuemax="100" style="height: 10px;">
                                    <div class="progress-bar bg-cat-{{ slug }}" style="width: {{ pct }}%"></div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            {# Répartition par statut #}
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 pt-4 px-4">
                        <h2 class="h5 mb-0"><i class="bi bi-flag me-2"></i>Par statut</h2>
                    </div>
                    <div class="card-body px-4">
                        <ul class="list-group list-group-flush">
                            {% for slug, s in statuts %}
                                {% set nb = evenements|filter(e => e.statut == slug)|length %}
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <span><span class="badge text-bg-{{ s.color }} me-2">&nbsp;</span>{{ s.label }}</span>
                                    <span class="fw-bold">{{ nb }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>

            {# Tableau détaillé #}
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0 pt-4 px-4">
                        <h2 class="h5 mb-0"><i class="bi bi-table me-2"></i>Remplissage par événement</h2>
                    </div>
                    <div class="card-body px-4">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Événement</th>
                                        <th class="d-none d-md-table-cell">Catégorie</th>
                                        <th>Statut</th>
                                        <th class="text-end">Places</th>
                                        <th style="min-width: 120px;">Remplissage</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for e in evenements %}
                                        {% set pct = e.places_totales > 0 ? ((e.places_totales - e.places_disponibles) / e.places_totales * 100)|round : 0 %}
                                        <tr>
                                            <td><a href="{{ path('app_evenement_details', { id: e.id }) }}" class="link-body-emphasis">{{ e.titre }}</a></td>
                                            <td class="d-none d-md-table-cell"><span class="badge bg-cat-{{ e.categorie }} text-capitalize">{{ e.categorie }}</span></td>
                                            <td>{% include 'components/_statut_badge.html.twig' with { evenement: e } %}</td>
                                            <td class="text-end text-nowrap">{{ e.places_totales - e.places_disponibles }} / {{ e.places_totales }}</td>
                                            <td>
                                                <div class="progress" style="height: 6px;">
                                                    <div class="progress-bar {{ pct >= 100 ? 'bg-danger' : (pct >= 80 ? 'bg-warning' : 'bg-success') }}" style="width: {{ pct }}%"></div>
                                                </div>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr><td colspan="5" class="text-center text-body-secondary py-4">Aucune donnée disponible.</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
